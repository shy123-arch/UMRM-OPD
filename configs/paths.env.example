# Copy to configs/paths.env and edit. Every script sources configs/paths.env if it exists; python defaults otherwise.
# --- data / outputs
export VHO_DATA=/path/to/umrm_vho_data_v1197aug      # ModelScope dataset (tools/fetch.sh)
export VHO_CKPT=/path/to/umrm_vho_ckpt               # ModelScope model repo: head_pre.pt, vq_v860.pt (+ optional trained adapters)
export VHO_RUNS=$PWD/runs                            # all training / eval outputs
export VHO_CACHE=/local/ssd/vho_cache                # regenerable caches (video tensors, text/vis feats); ~25 GB for v1197aug
# --- models / external data
export VHO_QWEN=/path/to/Qwen3-VL-4B-Instruct        # modelscope: Qwen/Qwen3-VL-4B-Instruct
export VHO_QWEN8B=/path/to/Qwen3-VL-8B-Instruct      # only for data_build/a1_mr_gen.py
export VHO_HML3D=/path/to/HumanML3D                  # new_joint_vecs/, texts/, train.txt/val.txt/test.txt (HumanML3D licence)
export VHO_HERO=/path/to/HERO_release                # github.com/JackYu6/HERO_release @475774d + checkpoints/vimo/{rvq_bs256_finetune_ep10,mtrans_memo_cross_l6_bs64_ep200,rtrans_memo_cross_l6_bs64_ep200}
# --- python interpreters (3 environments, see envs/README.md)
export VHO_PY_QWEN=/path/to/envs/vho-qwen/bin/python       # transformers 5.3, peft 0.19, flash-attn 2.8, torch 2.6
export VHO_PY_HERO=/path/to/envs/vho-hero/bin/python       # torch 1.12 (HERO)
export VHO_PY_KIMODO=/path/to/envs/vho-kimodo/bin/python   # Kimodo + TMR evaluator
export VHO_HERO_TORCHLIB=/path/to/envs/vho-hero/lib/python3.10/site-packages/torch/lib
# --- evaluator only (official HumanML3D TMR + frozen Kimodo); not needed for training
export VHO_KIMODO_REPO=/path/to/kimodo               # github.com/nv-tlabs/kimodo @54257dd
export VHO_KIMODO_CKPT=/path/to/Kimodo-SOMA-RP-v1.1
export VHO_LLM2VEC_BASE=/path/to/Meta-Llama-3-8B-Instruct
export VHO_LLM2VEC_ADAPTER=/path/to/LLM2Vec-Meta-Llama-3-8B-Instruct-mntp-supervised
export VHO_TMR_ASSETS=/path/to/tmr_assets            # third_party/umrm_eval/generation_benchmark_v1/setup_tmr.py downloads it
export VHO_TMR_SOMA=/path/to/TMR-SOMA-RP-v1           # reward-side TMR (Kimodo release); loaded by the evaluator engine
